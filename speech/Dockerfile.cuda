# Speech service on an NVIDIA GPU: faster-whisper in-process, same WebSocket protocol as the Mac build.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY pyproject.toml ./
COPY src ./src
RUN uv pip install --system --no-cache ".[cuda]" nvidia-cublas-cu12 "nvidia-cudnn-cu12>=9,<10"
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib \
    ASR_ENGINE=faster-whisper STT_MODEL=large-v3-turbo ASR_DEVICE=cuda ASR_COMPUTE_TYPE=float16 \
    HF_HOME=/models
EXPOSE 8200
CMD ["uvicorn", "speech.app:app", "--host", "0.0.0.0", "--port", "8200"]
