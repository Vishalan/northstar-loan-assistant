# Copy to .env. Everything runs without any keys (deterministic planner, browser voice).
# Every module below can be pointed at a cloud service or a self-hosted alternative; see ARCHITECTURE.md,
# "Swappable modules".

# ---- LLM planner. Leave keys unset to use the deterministic intent planner.
# Provider from backend/src/orchestrator/providers.yaml: native | abhi | selfhosted | bedrock | vertex
LLM_PROVIDER=native            # (ANTHROPIC_MODE is the older name for this)
LLM_MODE=auto                  # auto | llm | fallback | stub (stub = simulated LLM latency, never calls the API)
ANTHROPIC_API_KEY=
MODEL_PLANNER=claude-haiku-5-5 # Claude API ids. Swap at runtime: PUT /v1/admin/model
MODEL_FAILOVER=                # tried if the active model errors; empty = provider default (claude-opus-5-5)
PLANNER_EFFORT=low
LLM_SERVER_FALLBACKS=true      # server-side refusal fallback; native API only

# Anthropic-compatible proxy (LLM_PROVIDER=abhi). A third party: every prompt passes through it. Fine for this
# synthetic demo, not for real customer data. It only serves some models as asked (it answered claude-haiku-5-5
# with claude-opus-4-8), so the planner is limited to the models listed in providers.yaml.
ANTHROPIC_ABHI_API_KEY=
ANTHROPIC_ABHI_BASE_URL=https://opus.abhibots.com

# Open-weight model on your own GPU through Ollama's Messages API (LLM_PROVIDER=selfhosted).
# See deploy/selfhosted/README.md. Each provider can name its own model: <PROVIDER>_MODEL, <PROVIDER>_FAILOVER.
SELFHOSTED_LLM_URL=            # e.g. http://gpu-box:11434 (Tailscale name or address)
SELFHOSTED_MODEL=qwen3:14b

# Claude on AWS Bedrock (LLM_PROVIDER=bedrock; AWS credentials from the usual chain) or Google Vertex AI
# (LLM_PROVIDER=vertex). Model ids differ per cloud: set BEDROCK_MODEL / VERTEX_MODEL.
AWS_REGION=
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=

# ---- Security (change for anything shared). With DEMO_MODE=false the API refuses to start on these values.
JWT_SECRET=dev-jwt-secret-change-me-in-production-0123
SERVICE_TOKEN=dev-service-token
ADMIN_TOKEN=dev-admin-token
DEMO_MODE=true                 # on-screen demo OTP codes, persona picker, chaos controls

# ---- Enterprise systems: one URL per system; point any of them at a real service instead of the mock.
MOCKS_URL=http://localhost:8100
# CRM_URL= LOANS_URL= PAYMENTS_URL= POLICY_URL= OPS_URL= CARDS_URL=
CHAOS_PRESET=realistic         # calm | realistic | bad_day
PACKS_DIR=                     # workflow packs folder; default backend/packs

# ---- State
REDIS_URL=                     # session/cache store; set to share sessions across replicas (ElastiCache, Memorystore)
APP_DB=                        # SQLite file for audit, turns, spans (default backend/var/app.db)
APP_DB_URL=                    # postgresql://... instead (RDS, Cloud SQL); `uv sync --extra postgres`
DEMO_TODAY=2026-10-27          # the synthetic data is anchored to this date
TURN_RATE_LIMIT=20             # turns per customer per minute
CORS_ORIGINS=http://localhost:3000

# ---- Speech service (speech/). Recognition engine: parakeet-mlx (Apple Silicon default) | faster-whisper
# (NVIDIA GPU) | openai (any OpenAI-compatible transcription API: OpenAI, Groq, a self-hosted server).
ASR_ENGINE=
STT_MODEL=
ASR_URL=
ASR_API_KEY=
# Server voice: openai (any OpenAI-compatible /v1/audio/speech: Kokoro on your GPU, OpenAI) | none
TTS_ENGINE=none
TTS_URL=
TTS_API_KEY=
TTS_VOICE=af_heart

# ---- Web app (web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STT_URL=http://localhost:8200   # speech service for recognition; empty = the browser's recogniser
NEXT_PUBLIC_TTS_URL=                        # speech service for the voice; empty = the browser's voice
