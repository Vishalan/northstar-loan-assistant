# Copy to .env. Everything runs without any keys (deterministic planner, browser voice).

# Claude planner. Leave the keys unset to use the deterministic intent planner.
ANTHROPIC_MODE=native          # native = Anthropic API (ANTHROPIC_API_KEY) | abhi = Opus Proxy (ANTHROPIC_ABHI_API_KEY)
ANTHROPIC_API_KEY=
ANTHROPIC_ABHI_API_KEY=
ANTHROPIC_ABHI_BASE_URL=https://opus.abhibots.com
# The proxy is a third party: every prompt passes through it. Fine for this synthetic demo, not for real
# customer data. It only serves some models as asked (it answered claude-haiku-5-5 with claude-opus-4-8), so
# in abhi mode the planner is limited to: claude-haiku-4-5, claude-sonnet-5, claude-opus-5-5, claude-opus-5,
# claude-opus-4-8, claude-fable-5-1. An unsupported MODEL_PLANNER falls back to claude-haiku-4-5 with a warning.
LLM_MODE=auto                  # auto | llm | fallback | stub (stub = simulated LLM latency, never calls the API)
MODEL_PLANNER=claude-haiku-5-5   # native default; use claude-haiku-4-5 in abhi mode. Swap at runtime: PUT /v1/admin/model
MODEL_FAILOVER=                  # tried if the active model errors; empty = provider default (claude-opus-5-5)
PLANNER_EFFORT=low
LLM_SERVER_FALLBACKS=true      # server-side refusal fallback; native API only, never sent to Haiku

# Security (change for anything shared)
JWT_SECRET=dev-jwt-secret-change-me-in-production-0123
SERVICE_TOKEN=dev-service-token
ADMIN_TOKEN=dev-admin-token
DEMO_MODE=true                 # shows demo OTP codes and the chaos controls

# Systems and state
MOCKS_URL=http://localhost:8100
CHAOS_PRESET=realistic         # calm | realistic | bad_day
REDIS_URL=                     # set to share sessions across orchestrator replicas
DEMO_TODAY=2026-10-27          # the synthetic data is anchored to this date
TURN_RATE_LIMIT=20             # turns per customer per minute
CORS_ORIGINS=http://localhost:3000

# Web app
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STT_URL=http://localhost:8200   # local speech recognition (make speech); empty = browser recogniser
